{
  "name": "bats-agriguard-website",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo build",
    "build:backend": "pnpm --filter @bats/shared-types build && pnpm --filter @bats/backend build",
    "start:backend": "node apps/backend/dist/main.js",
    "dev": "pnpm --parallel --filter @bats/backend --filter @bats/web dev",
    "dev:backend": "pnpm --filter @bats/backend dev",
    "dev:web": "pnpm --filter @bats/web dev",
    "dev:blockchain": "pnpm --filter @bats/blockchain compile",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "esbuild",
      "keccak",
      "prisma",
      "secp256k1",
      "sharp"
    ]
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
